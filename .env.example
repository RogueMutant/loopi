# ─── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=           # Supabase project URL (https://xxx.supabase.co)
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # Supabase anon/public key
SUPABASE_SERVICE_ROLE_KEY=          # Used by aggregator cron only — never expose client-side

# ─── Privy ─────────────────────────────────────────────────
NEXT_PUBLIC_PRIVY_APP_ID=           # From Privy dashboard (https://dashboard.privy.io)

# ─── AI ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                  # Used by classifier.ts — server-side only

# ─── Scraper ───────────────────────────────────────────────
WIZZHQ_SCRAPER_URL=                 # Optional: URL of WizzHQ scraper proxy

# ─── Cron ──────────────────────────────────────────────────
CRON_SECRET=                        # Shared secret for the Vercel cron route authorization header
